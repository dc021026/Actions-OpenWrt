# CR660X OpenWrt Configuration
# Xiaomi Mi Router CR660X (MT7621)

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr660x=y

# Kernel Configuration
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_DEBUG_INFO=y

# LuCI Web Interface
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# Network
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# WiFi
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-common=y

# Boot
CONFIG_PACKAGE_uboot-envtools=y

# Utils
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-server=y

# Optimization
CONFIG_DEFAULT_TARGET_OPTIMIZATION="-O2 -march=octeon -mtune=octeon"
CONFIG_GCC_USE_GRAPHITE=y

# Image Configuration
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_UBIFS_FREE_SPACE_RATIO=0

# IPv6
CONFIG_IPV6=y
CONFIG_PACKAGE_kmod-ipv6=y

# Firewall
CONFIG_PACKAGE_firewall3=y
CONFIG_PACKAGE_firewall3-i18n-zh-cn=y

# SSL/TLS
CONFIG_OPENSSL_ENGINE_BUILTIN_DEVCRYPTO=y
CONFIG_OPENSSL_WITH_CHACHA=y
CONFIG_OPENSSL_WITH_POLY1305=y

# Debugging (optional, uncomment for development)
# CONFIG_DEBUG=y
# CONFIG_KERNEL_DEBUG_FS=y
